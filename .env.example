# ── Analytics & Ad Pixels (Optional — only loaded into <head> when set) ─────────
# Google Analytics 4 Measurement ID (supports either VITE_GA_ID or NEXT_PUBLIC_GA_ID)
VITE_GA_ID=
# NEXT_PUBLIC_GA_ID=

# Meta (Facebook / Instagram) Pixel ID (supports either VITE_META_PIXEL_ID or NEXT_PUBLIC_META_PIXEL_ID)
VITE_META_PIXEL_ID=
# NEXT_PUBLIC_META_PIXEL_ID=

# ── Feature Flags ───────────────────────────────────────────────────────────────
VITE_SHOW_COMING_SOON=false
VITE_INSTANT_PRINTING_COMING_SOON=false
VITE_ENABLE_EMAIL_NOTIFICATIONS=true

# ── Business Contact / WhatsApp ─────────────────────────────────────────────────
# Country code + 10-digit mobile number without '+' (used for tel:, wa.me, and 1-tap WhatsApp orders)
VITE_CONTACT_NUMBER=919769989807

# ── Google Drive & Orders Sheet ─────────────────────────────────────────────────
VITE_GOOGLE_DRIVE_API_KEY=
VITE_GOOGLE_DRIVE_VIDEOS_FOLDER_ID=
VITE_GOOGLE_DRIVE_REELS_FOLDER_ID=
VITE_GOOGLE_APPS_SCRIPT_URL=
VITE_GOOGLE_ORDERS_SHEET_ID=

# ── EmailJS Order & Contact Notifications ───────────────────────────────────────
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_CONTACT_TEMPLATE_ID=
VITE_EMAILJS_ORDER_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_TO_EMAIL=
